{
  "name": "@freelensapp/freelens-cert-manager",
  "version": "0.1.0",
  "description": "Freelens v2 extension for managing cert-manager resources",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maifeeulasad/freelens-cert-manager.git"
  },
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">= 24.0.0",
    "freelens": "^2.0.0"
  },
  "copyright": "© 2025-2026 Maifee Ul Asad",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Maifee Ul Asad",
    "email": "maifeeulasad@gmail.com"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && vite build --mode main",
    "dev": "pnpm \"/^dev:(renderer|main)$/\"",
    "dev:main": "vite build --watch --mode main",
    "dev:renderer": "vite build --watch --no-emptyOutDir",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "type:check": "tsc -p src/main && tsc -p src/renderer",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm biome check",
    "lint:fix": "pnpm biome check --fix",
    "clean": "pnpm dlx shx@0.4.0 rm -rf dist",
    "pack:dev": "pnpm version --no-commit-hooks --no-git-checks --no-git-tag-version prerelease && pnpm build && pnpm clean:tgz && pnpm pack",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\""
  },
  "devDependencies": {
    "@freelensapp/extensions": "2.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "cert-manager",
    "certificates",
    "tls",
    "kubernetes",
    "extension",
    "freelensapp",
    "freelens"
  ],
  "packageManager": "pnpm@12.15.0"
}
